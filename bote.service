[Unit]
Description=MumbleBote
After=network.target
After=systemd-user-sessions.service
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=10
.
[Service]
User=root
Restart=always
Type=simple
ExecStart=/_path_to_bote_/mumble_bote.pl
WorkingDirectory=/_path_to_bote_/
RestartSec=10

[Install]
WantedBy=multi-user.target
